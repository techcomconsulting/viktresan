rules_version = '2';

// Säkerhetsregler för Viktresan.
// Grundregel: allt är privat. Andra ser bara det du uttryckligen har delat.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isOwner(owner) { return signedIn() && me() == owner; }
    function sharePath(owner) {
      return /databases/$(database)/documents/shares/$(owner + '_' + request.auth.uid);
    }
    // Har ägaren delat just den här saken med mig, och är delningen accepterad?
    function shared(owner, perm) {
      return signedIn()
        && exists(sharePath(owner))
        && get(sharePath(owner)).data.status == 'active'
        && get(sharePath(owner)).data.perms[perm] == true;
    }
    // Historik: antingen allt, eller bara de senaste 3 månaderna.
    function inRange(owner) {
      return get(sharePath(owner)).data.historyRange == 'all'
        || resource.data.at > request.time - duration.value(92, 'd');
    }

    // Uppslag för att hitta varandra. Man måste veta exakt namn eller e-post.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == me()
        && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == me();
    }
    match /emails/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == me()
        && email == request.auth.token.email.lower();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /users/{uid} {
      // Din egen profil: bara du.
      allow read, write: if isOwner(uid);

      // Allt under din profil: du får göra allt.
      match /{path=**} {
        allow read, write: if isOwner(uid);
      }

      // Namn och profilbild, så att den du delar med ser vem du är.
      match /public/{docId} {
        allow get: if signedIn();
      }

      // Det andra får se, bara om du har delat det.
      // Vikt i kilo: bara om ägaren valt "Kilo och procent".
      match /summary/weight { allow get: if shared(uid, 'weight') && shared(uid, 'weightKg'); }
      // Vikt i procent: räcker att vikt är delad.
      match /summary/percent { allow get: if shared(uid, 'weight'); }
      match /summary/pct3m { allow get: if shared(uid, 'weight') && shared(uid, 'history'); }
      match /summary/pctAll {
        allow get: if shared(uid, 'weight') && shared(uid, 'history')
          && get(sharePath(uid)).data.historyRange == 'all';
      }
      match /summary/measures { allow get: if shared(uid, 'measures'); }
      match /weights/{id} {
        allow read: if shared(uid, 'weight') && shared(uid, 'weightKg') && shared(uid, 'history') && inRange(uid);
      }
      match /measures/{id} {
        allow read: if shared(uid, 'measures') && shared(uid, 'history') && inRange(uid);
      }
      match /photos/{id} { allow read: if shared(uid, 'photos'); }
      match /foodlog/{id} { allow read: if shared(uid, 'food'); }
      match /water/{id} { allow read: if shared(uid, 'food'); }
      match /workouts/{id} { allow read: if shared(uid, 'food'); }
      match /treatments/{id} { allow read: if shared(uid, 'treatment'); }
      match /blood/{id} { allow read: if shared(uid, 'blood'); }

    }

    // Inlägg. Ägaren väljer vem som ser: de man delar med, en grupp, vissa personer eller alla i appen.
    function canSeePost(p) {
      return signedIn() && (
        p.owner == me()
        || p.public == true
        || me() in p.viewers
        || (p.audience == 'shares' && shared(p.owner, 'posts'))
      );
    }
    function postData(pid) {
      return get(/databases/$(database)/documents/posts/$(pid)).data;
    }
    match /posts/{pid} {
      allow read: if canSeePost(resource.data);
      allow create: if signedIn()
        && request.resource.data.owner == me()
        && request.resource.data.viewers is list
        && request.resource.data.viewers.size() <= 50
        && request.resource.data.public is bool
        && request.resource.data.audience in ['shares', 'public', 'group', 'people'];
      allow update: if signedIn() && resource.data.owner == me() && request.resource.data.owner == me();
      allow delete: if signedIn() && resource.data.owner == me();

      match /comments/{cid} {
        allow read: if canSeePost(postData(pid));
        allow create: if canSeePost(postData(pid))
          && request.resource.data.uid == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow delete: if signedIn() && (resource.data.uid == me() || postData(pid).owner == me());
      }
      match /reactions/{rid} {
        allow read: if canSeePost(postData(pid));
        allow write: if canSeePost(postData(pid)) && rid == me();
        allow delete: if signedIn() && postData(pid).owner == me();
      }
    }

    // Varor som någon i appen har lagt till (t.ex. en streckkod som saknades).
    // Alla inloggade kan läsa. Bara den som skapade varan kan ändra den.
    match /foods/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.per100.kcal is number;
      allow update, delete: if signedIn() && resource.data.createdBy == me();
    }

    // Antal användare. Bara siffran. Bara admin kan läsa den.
    // Admin = den som har ett dokument i "admins" med sitt användar-id (läggs in för hand i Firebase).
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(me()));
    }
    function statsPath() { return /databases/$(database)/documents/stats/users; }
    function memberPath() { return /databases/$(database)/documents/stats/users/members/$(me()); }
    function oldCount() { return exists(statsPath()) ? get(statsPath()).data.count : 0; }

    match /admins/{uid} {
      allow get: if signedIn() && me() == uid;
      allow list, write: if false;
    }
    match /stats/users {
      allow get: if isAdmin();
      // +1 bara när man lägger till sin egen markering, −1 bara när man tar bort den.
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['count'])
        && ((request.resource.data.count == oldCount() + 1 && !exists(memberPath()) && existsAfter(memberPath()))
          || (request.resource.data.count == oldCount() - 1 && exists(memberPath()) && !existsAfter(memberPath())));
      match /members/{uid} {
        allow get: if signedIn() && me() == uid;
        allow list: if false;
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['at'])
          && getAfter(statsPath()).data.count == oldCount() + 1;
        allow delete: if signedIn() && me() == uid
          && getAfter(statsPath()).data.count == oldCount() - 1;
      }
    }

    // Rapport till vården: en tillfällig länk som läkaren kan öppna utan konto.
    // Id:t är en lång slumpad nyckel. Ingen kan lista andras rapporter.
    match /reports/{token} {
      allow get: if resource.data.expires > request.time
        || (signedIn() && resource.data.owner == me());
      allow list: if signedIn() && resource.data.owner == me();
      allow create: if signedIn()
        && token.size() >= 40
        && request.resource.data.owner == me()
        && request.resource.data.expires is timestamp
        && request.resource.data.expires < request.time + duration.value(31, 'd');
      allow delete: if signedIn() && resource.data.owner == me();
      allow update: if false;
    }

    // Delningar mellan två personer. Id = ägare_mottagare.
    match /shares/{id} {
      allow read: if signedIn()
        && (resource.data.owner == me() || resource.data.viewer == me());
      allow create: if signedIn()
        && request.resource.data.owner == me()
        && request.resource.data.viewer != me()
        && id == me() + '_' + request.resource.data.viewer
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && (
        // Mottagaren får bara acceptera.
        (resource.data.viewer == me()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']))
        ||
        // Ägaren får bara ändra vad som delas.
        (resource.data.owner == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perms', 'historyRange', 'updatedAt']))
      );
      allow delete: if signedIn()
        && (resource.data.owner == me() || resource.data.viewer == me());
    }

    // Notiser inne i appen.
    match /notifications/{uid}/items/{nid} {
      allow read, update, delete: if isOwner(uid);
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.text is string
        && request.resource.data.text.size() < 300;
    }
  }
}
